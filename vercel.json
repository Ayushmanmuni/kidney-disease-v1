{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/predict", "dest": "/api/index" },
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/static/(.*)", "dest": "/public/static/$1" },
    { "src": "/(.*\\.html)", "dest": "/public/$1" },
    { "src": "/(.*\\.css)", "dest": "/public/$1" },
    { "src": "/(.*\\.js)", "dest": "/public/$1" },
    { "src": "/login", "dest": "/public/login.html" },
    { "src": "/signup", "dest": "/public/signup.html" },
    { "src": "/dashboard", "dest": "/public/dashboard.html" },
    { "src": "/about-ckd", "dest": "/public/about-ckd.html" },
    { "src": "/how-it-works", "dest": "/public/how-it-works.html" },
    { "src": "^/$", "dest": "/public/index.html" }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/predict", "destination": "/api/index?__vp=/predict" },
    { "source": "/api/:path*", "destination": "/api/index?__vp=/api/:path*" }
  ]
}
